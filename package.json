{
  "name": "surajfale-portfolio",
  "version": "1.0.0",
  "type": "module",
  "description": "Modern single-page portfolio website for Suraj Fale",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-writing.mjs && node scripts/generate-llms-txt.mjs && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "sync:writing": "node scripts/fetch-writing.mjs",
    "sync:llms": "node scripts/generate-llms-txt.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "keywords": [
    "portfolio",
    "react",
    "material-ui",
    "typescript"
  ],
  "author": "Suraj Fale",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.3.2",
      "ajv": "^6.14.0",
      "flatted": "^3.4.2",
      "yaml": "^1.10.3",
      "postcss": "^8.5.23",
      "nanoid": "^3.3.18",
      "minimatch": "^11.0.1",
      "picomatch@<2.3.2": ">=2.3.2"
    }
  }
}
